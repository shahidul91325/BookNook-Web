# ==============================================================================
# BookNook Environment Variables Configuration
# ==============================================================================

# Express Backend REST API base URL (Do not modify backend contracts)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth Secret (Generate a secure 32+ character random secret)
BETTER_AUTH_SECRET=your_32_character_random_secret_here

# Better Auth Base URL (Points to Next.js route handler at /api/auth)
BETTER_AUTH_URL=http://localhost:3000

# Optional: If you want auth requests to hit a standalone external auth service,
# uncomment and set NEXT_PUBLIC_AUTH_URL. Otherwise it defaults to same-origin /api/auth.
# NEXT_PUBLIC_AUTH_URL=http://localhost:3000/api/auth

# MongoDB Database Connection (Used by Better Auth MongoDB Adapter)
# Default connects to local MongoDB instance
MONGODB_URI=mongodb://localhost:27017/booknook
MONGODB_DB_NAME=booknook

# Google OAuth Credentials
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/
# 2. Go to APIs & Services > OAuth consent screen (configure User Type: External)
# 3. Go to APIs & Services > Credentials > Create Credentials > OAuth client ID
#    - Application type: Web application
#    - Authorized JavaScript origins: http://localhost:3000
#    - Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Image Storage Options:
# If IMGBB_API_KEY is provided, images will be automatically hosted on ImgBB.
# If omitted or empty, images are securely stored in public/uploads/
IMGBB_API_KEY=
