# Frontend environment variables. NEXT_PUBLIC_* values are exposed to the browser;
# IMGBB_API_KEY is server-only and must never use the NEXT_PUBLIC_ prefix.

# Express API origin used for REST requests and the same-origin /api/auth rewrite.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional server-side ImgBB key. Only needed for book-cover uploads.
IMGBB_API_KEY=
