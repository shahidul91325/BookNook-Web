# ==============================================================================
# BookNook Environment Variables Configuration
# ==============================================================================

# Express Backend REST API base URL (Do not modify backend contracts)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth is hosted by Express. Browser auth calls use the same-origin
# /api/auth path; Next.js rewrites it to this server URL. Keep the auth server
# URL server-only so the browser's session cookie belongs to the frontend host.
NEXT_PUBLIC_AUTH_URL=http://localhost:3000/api/auth
AUTH_SERVER_URL=http://localhost:5000/api/auth

# Better Auth secret, Google OAuth credentials, and MongoDB connection belong
# in BookNook-Server/.env only. Do not configure them in the Next.js app.

# Image Storage Options:
# If IMGBB_API_KEY is provided, images will be automatically hosted on ImgBB.
# If omitted or empty, images are securely stored in public/uploads/
IMGBB_API_KEY=
