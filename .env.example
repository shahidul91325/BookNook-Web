# Local frontend configuration. Copy to .env.local; never add server secrets here.

# Public Express REST API origin (direct browser requests use this value).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public frontend origin used to resolve the same-origin Better Auth path.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=/api/auth

# Server-side Next.js rewrite destination for the sole Better Auth server.
AUTH_SERVER_URL=http://localhost:5000/api/auth

# Optional server-side image upload provider key. Leave empty to disable uploads.
IMGBB_API_KEY=
